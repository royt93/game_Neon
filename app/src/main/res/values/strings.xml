    <string name="story_beat_ch1">Nửa đường Vành đai rồi. Giữ vững tay lái, phi công.</string>
    <string name="story_beat_ch2">Radar bắt được tín hiệu lạ trong sương mù. Cẩn thận.</string>
    <string name="story_beat_ch3">Băng đang nứt bên dưới. Không còn đường lui đâu.</string>
    <string name="story_beat_ch4">Trạm địch đã biết ta tới. Chúng đang dồn quân.</string>
    <string name="story_beat_ch5">Lõi Thiên Hà ngay trước mặt. Định mệnh gọi tên anh.</string>
    <string name="story_final_phase2">Ngươi khá đấy… nhưng ta chỉ mới khởi động thôi!</string>
    <string name="story_final_phase3">Đủ rồi! Ta sẽ nghiền ngươi thành tro bụi vũ trụ!</string>
    <string name="story_defeat_final">Không… thể… nào… Thiên hà… thuộc về… ngươi…</string>
    <string name="story_defeat_hell_lord">Địa ngục… vẫn chờ ngươi… phi công…</string>
    <string name="story_defeat_white_dragon">Bạch Long… gục ngã… lần đầu tiên…</string>
    <string name="story_defeat_hammer_sickle">Cách mạng… thất bại rồi sao…?</string>
    <string name="story_defeat_crypto_bro">Không! Danh mục của ta… về zero rồi!</string>
    <string name="story_defeat_kitchen_god">Ta sẽ tâu Ngọc Hoàng… chuyện này!</string>
    <string name="story_defeat_generic">Gục… ngã…</string>
    <string name="story_epilogue_easy">Vành sáng bình minh trải khắp các hành tinh vừa được cứu. Một khởi đầu đẹp, phi công — thiên hà sẽ nhớ tên anh.</string>
    <string name="story_epilogue_normal">Khói tan, các vì sao lặng yên trở lại. Đội trưởng, anh đã trả lại bình yên cho cả một thiên hà.</string>
    <string name="story_epilogue_hard">Ngay cả bóng tối sâu nhất cũng phải lùi bước. Tên anh giờ khắc giữa những vì sao — huyền thoại Sky Force U*S*A.</string>
