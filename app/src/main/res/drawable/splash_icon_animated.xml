<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash icon động (Android 12+ windowSplashScreenAnimatedIcon).

  Thiết kế ĐỒNG BỘ với Compose SplashScreen (ui/splash/SplashScreen.kt): cùng
  ngôn ngữ thị giác "huy hiệu tròn neon + vầng sáng pulse cyan/magenta" để khi
  splash hệ thống fade sang Compose splash (logo splash_image + tên app) trông
  liền mạch, không nhảy hình.

  Khớp với Compose:
    • Vầng sáng radial pulse cyan↔magenta, nhịp 900ms reverse (y như pulse của
      Compose: scale 0.92↔1.08).
    • Bảng màu chính xác: NeonCyan #00F0FF, NeonMagenta #FF2DE0, nền #05010F.
    • Chiến cơ chĩa lên-phải ~32° (cùng hướng phi thuyền trong splash_image).

  Quy ước canvas splash Android 12+: viewport 1152x1152, chỉ vùng tròn đường
  kính ~768 ở giữa (bán kính ~384 quanh tâm 576,576) là an toàn. Mọi phần tử ở
  đây (kể cả lúc pulse phóng to 1.08 và overshoot) đều nằm trong bán kính ~370.

  Thuần vector + màu ĐẶC (không gradient) để render đúng từ minSdk 23 khi
  framework SplashScreen nạp drawable (ngoài luồng support-lib của Compose).
-->
<animated-vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <!-- ============ VECTOR TĨNH ============ -->
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="1152"
            android:viewportHeight="1152">

            <!-- Vầng sáng radial (3 đĩa đồng tâm, đặc → mờ) — pulse cyan/magenta
                 giả lập radialGradient của Compose splash -->
            <group
                android:name="pulse"
                android:pivotX="576"
                android:pivotY="576">
                <path
                    android:name="halo_out"
                    android:pathData="M576,236 a340,340 0 1,0 0,680 a340,340 0 1,0 0,-680 Z"
                    android:fillColor="#00F0FF"
                    android:fillAlpha="0" />
                <path
                    android:name="halo_mid"
                    android:pathData="M576,306 a270,270 0 1,0 0,540 a270,270 0 1,0 0,-540 Z"
                    android:fillColor="#FF2DE0"
                    android:fillAlpha="0" />
                <path
                    android:name="halo_in"
                    android:pathData="M576,386 a190,190 0 1,0 0,380 a190,190 0 1,0 0,-380 Z"
                    android:fillColor="#00F0FF"
                    android:fillAlpha="0" />
            </group>

            <!-- Vòng emblem ngoài (nạp + xoay) — cyan -->
            <group
                android:name="ring_rot"
                android:pivotX="576"
                android:pivotY="576">
                <path
                    android:name="ring_glow"
                    android:pathData="M576,276 a300,300 0 1,0 0,600 a300,300 0 1,0 0,-600 Z"
                    android:strokeColor="#00F0FF"
                    android:strokeWidth="28"
                    android:strokeAlpha="0.30"
                    android:trimPathEnd="0" />
                <path
                    android:name="ring_core"
                    android:pathData="M576,276 a300,300 0 1,0 0,600 a300,300 0 1,0 0,-600 Z"
                    android:strokeColor="#9FF8FF"
                    android:strokeWidth="9"
                    android:strokeLineCap="round"
                    android:trimPathEnd="0" />
            </group>

            <!-- Cung quỹ đạo magenta (đoạn 30%, quay ngược) -->
            <group
                android:name="ring_rot2"
                android:pivotX="576"
                android:pivotY="576">
                <path
                    android:name="ring_arc"
                    android:pathData="M576,316 a260,260 0 1,0 0,520 a260,260 0 1,0 0,-520 Z"
                    android:strokeColor="#FF2DE0"
                    android:strokeWidth="6"
                    android:strokeLineCap="round"
                    android:strokeAlpha="0"
                    android:trimPathStart="0"
                    android:trimPathEnd="0.30" />
            </group>

            <!-- Sao lấp lánh (cyan + magenta) -->
            <path
                android:name="star1"
                android:pathData="M760,354 L767.3,372.7 L786,380 L767.3,387.3 L760,406 L752.7,387.3 L734,380 L752.7,372.7 Z"
                android:fillColor="#6FF4FF"
                android:fillAlpha="0.15" />
            <path
                android:name="star2"
                android:pathData="M430,500 L435.6,514.4 L450,520 L435.6,525.6 L430,540 L424.4,525.6 L410,520 L424.4,514.4 Z"
                android:fillColor="#FF6BEC"
                android:fillAlpha="0.15" />
            <path
                android:name="star3"
                android:pathData="M700,724 L705,737 L718,742 L705,747 L700,760 L695,747 L682,742 L695,737 Z"
                android:fillColor="#6FF4FF"
                android:fillAlpha="0.15" />
            <path
                android:name="star4"
                android:pathData="M412,668 L418.2,683.8 L434,690 L418.2,696.2 L412,712 L396.2,696.2 L380,690 L396.2,683.8 Z"
                android:fillColor="#FF6BEC"
                android:fillAlpha="0.15" />

            <!-- Chiến cơ neon — chĩa lên-PHẢI khớp splash_image. Android xoay
                 theo chiều kim đồng hồ với góc DƯƠNG (trục y hướng xuống), nên
                 ship vẽ chĩa thẳng lên + rotation=35 → mũi hướng ~1 giờ.
                 Lửa động cơ nằm trong group tàu để thừa hưởng góc xoay (phụt
                 về dưới-trái, đúng phía đuôi). -->
            <group
                android:name="ship"
                android:pivotX="576"
                android:pivotY="576"
                android:rotation="35"
                android:scaleX="0.5"
                android:scaleY="0.5">

                <!-- Lửa động cơ (phụt nhịp), pivot ở đỉnh lửa -->
                <group
                    android:name="flame"
                    android:pivotX="576"
                    android:pivotY="716">
                    <path
                        android:name="flame_glow"
                        android:pathData="M552,716 L600,716 L590,772 L576,820 L562,772 Z"
                        android:fillColor="#FF2DE0"
                        android:fillAlpha="0" />
                    <path
                        android:name="flame_core"
                        android:pathData="M560,720 L592,720 L584,768 L576,808 L568,768 Z"
                        android:fillColor="#BFF9FF"
                        android:fillAlpha="0" />
                </group>

                <path
                    android:name="ship_glow"
                    android:pathData="M576,352 L604,470 L604,556 L676,628 L700,660 L620,648 L606,700 L642,760 L590,742 L576,720 L562,742 L510,760 L546,700 L532,648 L452,660 L476,628 L548,556 L548,470 Z"
                    android:strokeColor="#00F0FF"
                    android:strokeWidth="30"
                    android:strokeAlpha="0"
                    android:strokeLineJoin="round" />
                <path
                    android:name="ship_core"
                    android:pathData="M576,352 L604,470 L604,556 L676,628 L700,660 L620,648 L606,700 L642,760 L590,742 L576,720 L562,742 L510,760 L546,700 L532,648 L452,660 L476,628 L548,556 L548,470 Z"
                    android:fillColor="#2A0A4D"
                    android:fillAlpha="0"
                    android:strokeColor="#8FF6FF"
                    android:strokeWidth="7"
                    android:strokeAlpha="0"
                    android:strokeLineJoin="round" />
                <path
                    android:name="cockpit"
                    android:pathData="M576,398 L592,440 L588,512 L576,528 L564,512 L560,440 Z"
                    android:fillColor="#FF2DE0"
                    android:fillAlpha="0" />
            </group>
        </vector>
    </aapt:attr>

    <!-- ============ ANIMATIONS ============ -->

    <!-- Vầng sáng: pulse scale 0.92↔1.08 (khớp Compose, 900ms reverse) -->
    <target android:name="pulse">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0.92"
                    android:valueTo="1.08"
                    android:duration="900"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:interpolator="@android:anim/linear_interpolator" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0.92"
                    android:valueTo="1.08"
                    android:duration="900"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:interpolator="@android:anim/linear_interpolator" />
            </set>
        </aapt:attr>
    </target>
    <!-- Vầng sáng: 3 đĩa hiện lên (so le nhẹ) -->
    <target android:name="halo_out">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="0.07"
                android:duration="520"
                android:startOffset="0"
                android:interpolator="@android:anim/decelerate_interpolator" />
        </aapt:attr>
    </target>
    <target android:name="halo_mid">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="0.11"
                android:duration="520"
                android:startOffset="40"
                android:interpolator="@android:anim/decelerate_interpolator" />
        </aapt:attr>
    </target>
    <target android:name="halo_in">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="0.16"
                android:duration="520"
                android:startOffset="80"
                android:interpolator="@android:anim/decelerate_interpolator" />
        </aapt:attr>
    </target>

    <!-- Vòng emblem: lõi tự vẽ -->
    <target android:name="ring_core">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1"
                android:duration="780"
                android:startOffset="60"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="ring_glow">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1"
                android:duration="820"
                android:startOffset="140"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="ring_rot">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="rotation"
                android:valueFrom="0"
                android:valueTo="360"
                android:duration="6000"
                android:repeatCount="infinite"
                android:interpolator="@android:anim/linear_interpolator" />
        </aapt:attr>
    </target>

    <!-- Cung magenta: hiện ra + quay ngược -->
    <target android:name="ring_arc">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="strokeAlpha"
                android:valueFrom="0"
                android:valueTo="0.9"
                android:duration="500"
                android:startOffset="200"
                android:interpolator="@android:anim/decelerate_interpolator" />
        </aapt:attr>
    </target>
    <target android:name="ring_rot2">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="rotation"
                android:valueFrom="360"
                android:valueTo="0"
                android:duration="7000"
                android:repeatCount="infinite"
                android:interpolator="@android:anim/linear_interpolator" />
        </aapt:attr>
    </target>

    <!-- Tàu: scale-in overshoot -->
    <target android:name="ship">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0.5"
                    android:valueTo="1"
                    android:duration="620"
                    android:startOffset="160"
                    android:interpolator="@android:anim/overshoot_interpolator" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0.5"
                    android:valueTo="1"
                    android:duration="620"
                    android:startOffset="160"
                    android:interpolator="@android:anim/overshoot_interpolator" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="ship_core">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="fillAlpha"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:duration="420"
                    android:startOffset="220"
                    android:interpolator="@android:anim/decelerate_interpolator" />
                <objectAnimator
                    android:propertyName="strokeAlpha"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:duration="420"
                    android:startOffset="220"
                    android:interpolator="@android:anim/decelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="ship_glow">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="strokeAlpha"
                android:valueFrom="0"
                android:valueTo="0.4"
                android:duration="520"
                android:startOffset="260"
                android:interpolator="@android:anim/decelerate_interpolator" />
        </aapt:attr>
    </target>
    <target android:name="cockpit">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="0.95"
                android:duration="360"
                android:startOffset="460"
                android:interpolator="@android:anim/decelerate_interpolator" />
        </aapt:attr>
    </target>

    <!-- Lửa: hiện lên + phụt nhịp -->
    <target android:name="flame_core">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="1"
                android:duration="260"
                android:startOffset="520"
                android:interpolator="@android:anim/decelerate_interpolator" />
        </aapt:attr>
    </target>
    <target android:name="flame_glow">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="0.5"
                android:duration="260"
                android:startOffset="520"
                android:interpolator="@android:anim/decelerate_interpolator" />
        </aapt:attr>
    </target>
    <target android:name="flame">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="scaleY"
                android:valueFrom="0.5"
                android:valueTo="1.18"
                android:duration="320"
                android:startOffset="520"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:interpolator="@android:anim/accelerate_decelerate_interpolator" />
        </aapt:attr>
    </target>

    <!-- Sao lấp lánh: alpha 0.15↔max, lệch pha so le -->
    <target android:name="star1">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0.15"
                android:valueTo="1"
                android:duration="1100"
                android:startOffset="0"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:interpolator="@android:anim/accelerate_decelerate_interpolator" />
        </aapt:attr>
    </target>
    <target android:name="star2">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0.15"
                android:valueTo="0.95"
                android:duration="1300"
                android:startOffset="350"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:interpolator="@android:anim/accelerate_decelerate_interpolator" />
        </aapt:attr>
    </target>
    <target android:name="star3">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0.15"
                android:valueTo="1"
                android:duration="900"
                android:startOffset="650"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:interpolator="@android:anim/accelerate_decelerate_interpolator" />
        </aapt:attr>
    </target>
    <target android:name="star4">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0.15"
                android:valueTo="0.9"
                android:duration="1200"
                android:startOffset="180"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:interpolator="@android:anim/accelerate_decelerate_interpolator" />
        </aapt:attr>
    </target>

</animated-vector>
